# ==============================================================================
# NemoDrive-AI Environment Configuration
# ==============================================================================

# NVIDIA NIM API Key (Get your free key with 1000 credits at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM Base URL (Standard NVIDIA NIM Inference Endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Latest Active NVIDIA Nemotron Models (Available on build.nvidia.com):
# - nvidia/nemotron-3.5-lightning-30b-a3b (Latest High-Efficiency MoE Agent Architecture)
# - nvidia/nemotron-3-super-120b-a12b
# - nvidia/llama-3.1-nemotron-70b-instruct
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Audio / Voice Settings
ENABLE_VOICE_TTS=true
VOICE_LANGUAGE=en
