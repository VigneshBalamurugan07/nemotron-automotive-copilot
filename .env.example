# ==============================================================================
# NemoDrive-AI Environment Configuration
# ==============================================================================

# NVIDIA NIM API Key (Get your free key with 1000 credits at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM Base URL (Standard NVIDIA NIM Inference Endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Selection:
# - nvidia/llama-3.1-nemotron-70b-instruct (Recommended for deep multi-step reasoning)
# - nvidia/nemotron-4-340b-instruct
# - nvidia/nemotron-mini-4b-instruct
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Audio / Voice Settings
ENABLE_VOICE_TTS=true
VOICE_LANGUAGE=en
